{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/ce-theme/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ce-theme/:path*", "destination": "/:path*" }
  ]
}
