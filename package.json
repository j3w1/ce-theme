{
  "name": "@casaelida/foundation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Casa Elida brand foundations, design tokens, HTML/CSS recipes, Vue components and the Astro reference showcase.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm build:vue && astro dev --host 127.0.0.1",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:vue": "pnpm --filter @casaelida/vue typecheck && pnpm --filter @casaelida/vue test",
    "build:vue": "pnpm --filter @casaelida/vue build",
    "build": "pnpm generate && pnpm build:vue && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "check": "pnpm validate && pnpm check:generated && pnpm test && pnpm test:vue && pnpm build"
  },
  "devDependencies": {
    "@astrojs/vue": "7.1.0",
    "@axe-core/playwright": "4.14.0",
    "@casaelida/vue": "workspace:*",
    "@playwright/test": "1.64.1",
    "astro": "7.4.2",
    "vue": "3.5.44"
  }
}
