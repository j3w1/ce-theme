{
  "name": "@casaelida/foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Casa Elida brand foundations, design tokens, HTML/CSS recipes, and visual reference.",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "pnpm generate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "check": "pnpm validate && pnpm check:generated && pnpm test && pnpm build"
  },
  "dependencies": { "@fontsource-variable/noto-sans": "5.3.0" },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "astro": "7.4.2"
  }
}
