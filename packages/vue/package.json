{
  "name": "@casaelida/vue",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Casa Elida Vue 3 components with their foundation styles and the Inter fonts. Import @casaelida/vue/styles.css once in the application.",
  "license": "UNLICENSED",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ../../scripts/package.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
