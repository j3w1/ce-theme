---
interface Props { eyebrow?: string; title: string; description?: string; href?: string; link?: string }
const { eyebrow, title, description, href, link } = Astro.props;
---
<div class="section-heading">
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{description && <p class="section-description">{description}</p>}</div>
  {href && <a class="ce-button ce-button--secondary" href={href}>{link ?? 'Explorar'}</a>}
</div>
