---
import Layout from '../layouts/Layout.astro';
import Price from '../components/Price.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<Layout title="Aplicaciones">
  <div class="container">
    <div class="page-intro"><p class="eyebrow">04 · Aplicaciones</p><h1>La misma marca.<br/>En cada formato.</h1><p>Una fotografía cuenta la historia. Una jerarquía clara muestra el producto. Cambia el soporte; la intención permanece.</p></div>
    <section class="section" style="padding-top:0"><SectionHeading title="Una base que se adapta." description="Cambia el formato para ver cómo el mismo contenido conserva su jerarquía. Los textos y el precio de esta muestra son HTML."/>
      <div class="application-options" role="group" aria-label="Formato de la composición">{[['square','Cuadrado · 1:1'],['story','Historia · 9:16'],['landscape','Pantalla · 16:9']].map(([value,label],i)=><button class="ce-chip" data-format={value} aria-pressed={String(i===0)}>{label}</button>)}</div>
      <div class="application-stage"><article class="ce-photo-panel application-art application-art--square" id="application-art"><img src="/references/campaign-kitchen.jpg" alt="Un contenedor colgante recoge restos de cocina junto a una tabla de cortar" width="1000" height="1000"/><div class="ce-photo-content"><span class="ce-code">CE25034101</span><h3>Contenedor colgante</h3><p>Plástico · 21 × 8 × 12.5cm</p><Price amount="4.5" variant="inverse"/></div></article><div class="application-meta"><span id="format-label">Formato 1:1 · Publicación</span><span>Contenido ilustrativo · Precio de ejemplo</span></div></div>
      <p class="small-note">Deja un margen de seguridad de al menos 8% alrededor del contenido esencial y 10% en la parte superior de historias. Valida cada pieza al tamaño final de lectura.</p>
    </section>
    <section class="section"><SectionHeading title="La marca en uso." description="Piezas originales suministradas por Casa Elida. Referencias de fotografía, códigos, medidas y precios; sus promociones no se consideran vigentes."/>
      <div class="gallery-grid"><figure class="gallery-card"><img src="/references/campaign-umbrella.jpg" alt="Paraguas con funda: campaña con fotografía de uso, muestras de colores y precio de ejemplo S/18.5" width="1000" height="1000" loading="lazy"/><figcaption><strong>Uso cotidiano</strong><span>Fotografía</span></figcaption></figure><figure class="gallery-card"><img src="/references/campaign-organisers.jpg" alt="Organizador: campaña con código CE26031111R/12R, materiales, medidas y precio de ejemplo S/5.5 cada uno" width="1000" height="1000" loading="lazy"/><figcaption><strong>Información cercana</strong><span>Tarjeta</span></figcaption></figure><figure class="gallery-card"><img src="/references/campaign-kitchen.jpg" alt="Contenedor colgante: campaña con código CE25034101 y precio de ejemplo S/4.5" width="1000" height="1000" loading="lazy"/><figcaption><strong>Pequeñas soluciones</strong><span>Contexto</span></figcaption></figure></div>
    </section>
    <section class="section"><SectionHeading title="Reglas que viajan con la marca."/><div class="rule-grid"><div><h3>En la tienda digital</h3><p>Producto completo sobre blanco, información en texto y precios accesibles. Las tarjetas se adaptan a dos, tres o cuatro columnas.</p></div><div><h3>En herramientas internas</h3><p>Superficies neutras, controles conocidos y códigos exactos. El rojo de marca no sustituye el significado de un error.</p></div><div><h3>En campañas</h3><p>Fotografías de uso, nombre claro y precio protagonista. Las tarjetas blancas reúnen detalles sin tapar el producto.</p></div><div><h3>En pantallas de tienda</h3><p>Una idea principal por pieza. Aumenta el tamaño del precio y del código según la distancia; comprueba la lectura en la pantalla real.</p></div></div></section>
  </div>
  <script>
    const labels: Record<string,string>={square:'Formato 1:1 · Publicación',story:'Formato 9:16 · Historia',landscape:'Formato 16:9 · Pantalla'};
    document.querySelectorAll<HTMLButtonElement>('[data-format]').forEach(button=>button.addEventListener('click',()=>{const format=button.dataset.format!; const art=document.querySelector('#application-art'); if(!art)return; art.classList.remove('application-art--square','application-art--story','application-art--landscape');art.classList.add(`application-art--${format}`);document.querySelectorAll('[data-format]').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));const label=document.querySelector('#format-label');if(label)label.textContent=labels[format];}));
  </script>
</Layout>
