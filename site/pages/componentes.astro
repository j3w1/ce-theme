---
import Layout from '../layouts/Layout.astro';
import { CEButton, CETextField } from '@casaelida/vue';
import Recipe from '../components/Recipe.astro';
import Icon from '../components/Icon.astro';
const buttonCode=`<button class="ce-button">Ver productos</button>
<button class="ce-button ce-button--secondary">Conocer más</button>
<button class="ce-button ce-button--ink">Explorar</button>
<button class="ce-button" disabled>No disponible</button>`;
const fieldCode=`<div class="ce-field">
  <label for="search">Buscar un producto</label>
  <input class="ce-input" id="search" type="search"
    placeholder="¿Qué estás buscando?" aria-describedby="search-note">
  <span class="ce-field-note" id="search-note">Nombre o código de producto.</span>
</div>`;
const errorCode=`<div class="ce-field">
  <label for="email">Correo electrónico</label>
  <input class="ce-input" id="email" type="email" value="nombre@"
    aria-invalid="true" aria-describedby="email-error">
  <span class="ce-field-error" id="email-error">Escribe un correo completo.</span>
</div>`;
const navCode=`<details class="ce-disclosure"><summary>Cuidados</summary>
  <div class="ce-disclosure-body">…</div></details>
<button class="ce-button ce-button--secondary" data-ce-open="quitar">Quitar</button>
<dialog class="ce-dialog" id="quitar" aria-labelledby="quitar-titulo">
  <div class="ce-dialog-header"><h2 id="quitar-titulo">¿Quitar de la bolsa?</h2>…</div>
  <div class="ce-dialog-body">…</div>
  <div class="ce-dialog-footer"><button class="ce-button" data-ce-close>Quitar</button></div>
</dialog>
<button popovertarget="acciones">Más acciones</button>
<div class="ce-menu" id="acciones" popover>
  <button class="ce-menu-item">Copiar código</button>
</div>`;
const feedbackCode=`<div class="ce-notice ce-notice--warning">
  <svg aria-hidden="true">…</svg>
  <div><strong>Precio no disponible en Arequipa</strong><p>Elige otra tienda.</p></div>
</div>
<span class="ce-spinner" role="status" aria-label="Cargando"></span>
<span class="ce-skeleton" aria-hidden="true"></span>
<div class="ce-toast-region" role="status" aria-live="polite">
  <div class="ce-toast">Agregado a tu bolsa <a class="ce-link" href="/bolsa">Ver bolsa</a></div>
</div>`;
const formsCode=`<label class="ce-switch"><input type="checkbox" role="switch">Publicar</label>
<div class="ce-input-group">
  <span class="ce-input-affix">S/</span>
  <input class="ce-input ce-input--number" inputmode="decimal" value="6.50">
</div>
<label class="ce-upload"><input type="file" accept="image/*">
  <span><strong>Elige una foto</strong> o arrástrala aquí</span></label>`;
const nativeCode=`<textarea class="ce-textarea"></textarea>
<fieldset class="ce-fieldset"><legend>Entrega</legend>
  <label class="ce-radio"><input type="radio" name="e" checked>Retiro en tienda</label>
</fieldset>
<input class="ce-range" type="range" aria-label="Volumen">
<input class="ce-input" type="date">
<input class="ce-input" type="file">
<input class="ce-color" type="color">
<meter class="ce-meter" value="72" min="0" max="100"></meter>`;
---
<Layout title="Componentes">
  <div class="container">
    <div class="page-intro"><p class="eyebrow">02 · Componentes</p><h1>Pequeñas piezas.<br/>Una misma intención.</h1><p>Recetas HTML y CSS que se adaptan a tu proyecto. Cada pieza usa la misma base de color, espacio y tipografía.</p></div>
    <Recipe title="Botones y acciones" description="Una acción principal por contexto. Las acciones secundarias mantienen una presencia más discreta." code={buttonCode}><div class="demo-row"><CEButton>Ver productos</CEButton><CEButton variant="secondary">Conocer más</CEButton><CEButton variant="ink">Explorar</CEButton><CEButton disabled>No disponible</CEButton></div><p class="small-note">Muestras de estado y estilo. Los botones de esta sección no ejecutan operaciones de tienda.</p></Recipe>
    <Recipe title="Iconos y enlaces" description="Acciones compactas con un nombre accesible. Los iconos decorativos se ocultan a lectores de pantalla." code={'<button class="ce-icon-button" aria-label="Guardar producto">\n  <!-- Inline SVG: aria-hidden="true", focusable="false" -->\n</button>\n<a class="ce-link" href="/catalogo/">Explorar el catálogo</a>'}><div class="demo-row"><button class="ce-icon-button" aria-label="Ejemplo: guardar producto"><Icon name="heart"/></button><button class="ce-icon-button" aria-label="Ejemplo: bolsa de compra"><Icon name="bag"/></button><a class="ce-icon-button ce-icon-button--ink" href="/descargas/" aria-label="Ir a los recursos descargables"><Icon name="arrow"/></a><a class="ce-link" href="/patrones/">Explorar las recetas de producto</a></div></Recipe>
    <Recipe title="Búsqueda y formularios" description="Etiquetas visibles, instrucciones breves y errores que explican cómo continuar." code={fieldCode}><div class="demo-fields"><CETextField id="sample-search" type="search" label="Buscar un producto" placeholder="¿Qué estás buscando?" note="Nombre o código de producto. Campo de muestra." /><div class="ce-field"><label for="sample-sort">Ordenar por</label><select class="ce-select" id="sample-sort"><option>Relevancia</option><option>Precio: menor a mayor</option><option>Novedades</option></select></div></div></Recipe>
    <Recipe title="Validación que ayuda" description="El borde y el mensaje trabajan juntos. El texto explica el problema sin depender solo del color." code={errorCode}><div class="demo-fields"><CETextField id="sample-email" type="email" label="Correo electrónico" modelValue="nombre@" error="Escribe un correo completo, por ejemplo: nombre@ejemplo.com." /><CETextField id="sample-code" label="Código de producto" modelValue="CE26061509" readonly note="Los códigos conservan sus caracteres originales." /></div></Recipe>
    <Recipe title="Categorías y filtros" description="Controles agrupados con un estado de selección visible. Esta muestra permite cambiar la categoría activa." code={'<div role="group" aria-label="Categorías">\n  <button class="ce-chip" aria-pressed="true">Todos</button>\n  <button class="ce-chip" aria-pressed="false">Cocina</button>\n</div>'}><div class="demo-row" data-choice-group role="group" aria-label="Ejemplo de selección de categoría">{['Todos','Cocina','Organización','Iluminación','Decoración'].map((name,i)=><button class="ce-chip" aria-pressed={String(i===0)}>{name}</button>)}</div></Recipe>
    <Recipe title="Etiquetas y estados" description="Información breve, con un nombre explícito además del color." code={'<span class="ce-badge ce-badge--offer">Llegó la Navidad</span>\n<span class="ce-badge ce-badge--yellow">Precio especial</span>\n<span class="ce-status ce-status--success">✓ Disponible</span>'}><div class="demo-row"><span class="ce-badge ce-badge--offer">Llegó la Navidad</span><span class="ce-badge ce-badge--yellow">Precio especial</span><span class="ce-badge">Nuevo</span><span class="ce-status ce-status--success">✓ Disponible</span><span class="ce-status ce-status--info">i Información</span></div></Recipe>
    <Recipe title="Muestras de color" description="Cada muestra tiene un nombre, un borde visible y un estado de selección. Los colores representan el producto, no nuevas variantes de marca." code={'<button class="ce-swatch" aria-label="Color: blanco"\n  aria-pressed="true" style="background:var(--ce-color-surface-canvas)"></button>'}><div class="ce-swatches" data-choice-group role="group" aria-label="Ejemplo de selección de color"><button class="ce-swatch" aria-label="Blanco" aria-pressed="true" style="background:var(--ce-color-surface-canvas)"></button><button class="ce-swatch" aria-label="Negro" aria-pressed="false" style="background:var(--ce-color-surface-inverse)"></button><button class="ce-swatch" aria-label="Gris" aria-pressed="false" style="background:var(--ce-color-text-muted)"></button></div></Recipe>
    <Recipe title="Tablas para herramientas de trabajo" description="Una aplicación neutra de la misma base. Códigos legibles, columnas claras y sin colores que compitan con los datos." code={'<table class="ce-table">\n  <caption>Productos de ejemplo</caption>\n  <thead><tr><th scope="col">Código</th><th scope="col">Producto</th></tr></thead>\n  <tbody><tr><td>CE26061509</td><td>Dispensador aceite</td></tr></tbody>\n</table>'}><div class="table-wrap"><table class="ce-table"><caption class="ce-sr-only">Productos de ejemplo para una herramienta interna</caption><thead><tr><th scope="col">Código</th><th scope="col">Producto</th><th scope="col">Detalle</th></tr></thead><tbody><tr><td><span class="ce-code">CE26061509</span></td><td>Dispensador aceite</td><td>Vidrio, 350ml</td></tr><tr><td><span class="ce-code">CE26018821</span></td><td>Portabocadito Corazón</td><td>Cerámica, dos niveles</td></tr></tbody></table></div></Recipe>
    <Recipe title="Navegación, pestañas y capas" description="Elementos nativos primero: details para contenido plegable, dialog para ventanas y cajones, popover para menús y ayudas. El comportamiento de referencia está en recipes/behaviors.mjs." code={navCode}>
      <nav class="ce-breadcrumbs" aria-label="Ruta de ejemplo"><ol><li><a href="#">Inicio</a></li><li><a href="#">Cocina</a></li><li><span aria-current="page">Tazas</span></li></ol></nav>
      <div class="ce-tabs" role="tablist" aria-label="Pestañas de ejemplo" style="margin-top:var(--ce-space-24)"><button class="ce-tab" role="tab" id="demo-tab-1" aria-controls="demo-panel-1" aria-selected="true">Detalles</button><button class="ce-tab" role="tab" id="demo-tab-2" aria-controls="demo-panel-2" aria-selected="false">Medidas</button></div>
      <div class="ce-tab-panel" role="tabpanel" id="demo-panel-1" aria-labelledby="demo-tab-1"><p style="margin:0">vidrio borosilicato, 250ml</p></div>
      <div class="ce-tab-panel" role="tabpanel" id="demo-panel-2" aria-labelledby="demo-tab-2" hidden><p style="margin:0">8 × 9cm</p></div>
      <details class="ce-disclosure"><summary>Cuidados</summary><div class="ce-disclosure-body">Información de ejemplo.</div></details>
      <div class="demo-row" style="margin-top:var(--ce-space-24)">
        <button class="ce-button ce-button--secondary" type="button" data-ce-open="demo-dialog">Abrir diálogo</button>
        <button class="ce-button ce-button--secondary" type="button" data-ce-open="demo-drawer">Abrir cajón</button>
        <button class="ce-button ce-button--secondary" type="button" popovertarget="demo-menu">Más acciones</button>
        <button class="ce-icon-button" type="button" popovertarget="demo-tip" aria-label="Qué es el código"><Icon name="info"/></button>
      </div>
      <div class="ce-menu" id="demo-menu" popover><button class="ce-menu-item" type="button"><Icon name="copy" size={18}/>Copiar código</button><button class="ce-menu-item" type="button"><Icon name="share" size={18}/>Compartir</button><button class="ce-menu-item" type="button" aria-disabled="true"><Icon name="trash" size={18}/>Eliminar (sin permiso)</button></div>
      <p class="ce-tooltip" id="demo-tip" popover>El código CE identifica el producto. Se copia exacto.</p>
      <dialog class="ce-dialog" id="demo-dialog" aria-labelledby="demo-dialog-title"><div class="ce-dialog-header"><h2 id="demo-dialog-title">¿Quitar de la bolsa?</h2><button class="ce-icon-button" type="button" data-ce-close aria-label="Cerrar"><Icon name="close"/></button></div><div class="ce-dialog-body"><p style="margin:0">Puedes volver a agregarlo cuando quieras.</p></div><div class="ce-dialog-footer"><button class="ce-button ce-button--secondary" type="button" data-ce-close>Cancelar</button><button class="ce-button" type="button" data-ce-close>Quitar</button></div></dialog>
      <dialog class="ce-drawer" id="demo-drawer" aria-labelledby="demo-drawer-title"><div class="ce-dialog-header"><h2 id="demo-drawer-title">Filtros</h2><button class="ce-icon-button" type="button" data-ce-close aria-label="Cerrar"><Icon name="close"/></button></div><div class="ce-dialog-body"><label class="ce-check"><input type="checkbox"/>Disponible en tu tienda</label></div><div class="ce-dialog-footer"><button class="ce-button" type="button" data-ce-close>Ver resultados</button></div></dialog>
    </Recipe>
    <Recipe title="Mensajes y estados de carga" description="Avisos con texto e icono, no solo color. Esqueletos y cargas sin mostrar datos viejos." code={feedbackCode}>
      <div style="display:grid;gap:var(--ce-space-12)">
        <div class="ce-notice ce-notice--success" role="status"><Icon name="check" size={20}/><div><strong>Guardado</strong><p>La ficha se actualizó.</p></div></div>
        <div class="ce-notice ce-notice--warning"><Icon name="info" size={20}/><div><strong>Precio no disponible en Arequipa</strong><p>Elige otra tienda o consulta más tarde.</p></div></div>
        <div class="ce-notice ce-notice--danger" role="alert"><Icon name="close" size={20}/><div><strong>No se pudo guardar</strong><p>Revisa tu conexión e inténtalo de nuevo.</p></div></div>
        <div class="demo-row"><span class="ce-spinner" role="status" aria-label="Cargando"></span><span class="ce-save-state" data-state="saved">Guardado</span><span class="ce-save-state" data-state="dirty">Cambios sin guardar</span><span class="ce-save-state" data-state="error">Error al guardar</span></div>
        <div style="display:grid;gap:8px;max-width:320px" aria-hidden="true"><span class="ce-skeleton" style="aspect-ratio:1"></span><span class="ce-skeleton"></span><span class="ce-skeleton" style="width:60%"></span></div>
        <progress class="ce-progress" max="100" value="60" aria-label="Carga de fotos">60%</progress>
        <div class="ce-toast" style="justify-self:start">Agregado a tu bolsa <a class="ce-link" href="/tienda/carrito/">Ver bolsa</a></div>
        <div class="ce-empty"><h3>Tu bolsa está vacía</h3><p>Guarda productos o explora las novedades.</p><a class="ce-button" href="/tienda/">Ir a la tienda</a></div>
      </div>
    </Recipe>
    <Recipe title="Formularios más completos" description="Interruptores, importes con prefijo, carga de archivos y fichas seleccionadas. Cada control tiene etiqueta visible." code={formsCode}>
      <div class="demo-fields">
        <label class="ce-switch"><input type="checkbox" role="switch" checked/>Publicar en la tienda</label>
        <CETextField id="demo-amount" class="ce-input--number" label="Precio de venta" prefix="S/" inputmode="decimal" modelValue="6.50" note="Texto decimal; el sistema de precios lo valida." />
        <fieldset class="ce-fieldset"><legend>Materiales</legend><ul class="ce-token-list"><li class="ce-token">vidrio borosilicato<button type="button" aria-label="Quitar vidrio borosilicato"><Icon name="close" size={14}/></button></li><li class="ce-token">bambú<button type="button" aria-label="Quitar bambú"><Icon name="close" size={14}/></button></li></ul></fieldset>
        <label class="ce-upload"><input type="file" accept="image/*"/><Icon name="download"/><span><strong>Elige una foto</strong> o arrástrala aquí</span><span>PNG o JPG, fondo blanco</span></label>
      </div>
    </Recipe>
    <Recipe title="Controles nativos con la marca" description="Cada elemento HTML tiene su receta: se estiliza el control nativo, no se reemplaza. La lista abierta del selector usa appearance: base-select donde el navegador lo admite; el selector de fecha, el de color y el diálogo de archivos siguen siendo del navegador." code={nativeCode}>
      <div class="demo-fields">
        <div class="ce-field"><label for="nat-select">Selector con grupos</label><select class="ce-select" id="nat-select"><optgroup label="Hogar"><option>Cocina</option><option>Baño</option></optgroup><optgroup label="Regalos"><option>Navidad</option><option disabled>Agotado</option></optgroup></select></div>
        <div class="ce-field"><label for="nat-text">Comentario</label><textarea class="ce-textarea" id="nat-text" placeholder="Cuéntanos qué necesitas"></textarea></div>
        <fieldset class="ce-fieldset"><legend>Entrega</legend><label class="ce-radio"><input type="radio" name="nat-delivery" checked/>Retiro en tienda</label><label class="ce-radio"><input type="radio" name="nat-delivery"/>Envío a domicilio</label></fieldset>
        <div class="ce-field"><label for="nat-range">Volumen</label><input class="ce-range" id="nat-range" type="range" min="0" max="100" value="70"/></div>
        <div class="ce-field"><label for="nat-date">Fecha de entrega</label><input class="ce-input" id="nat-date" type="date" value="2026-10-30"/></div>
        <div class="ce-field"><label for="nat-file">Foto del producto</label><input class="ce-input" id="nat-file" type="file" accept="image/*"/></div>
        <div class="ce-field"><label for="nat-color">Color de campaña</label><input class="ce-color" id="nat-color" type="color" value="#1f5f45"/></div>
        <div class="ce-field"><label for="nat-meter">Stock disponible</label><meter class="ce-meter" id="nat-meter" min="0" max="100" low="25" high="60" optimum="90" value="72">72</meter></div>
      </div>
    </Recipe>
  </div>
  <script>import { enhanceAll } from '../../recipes/behaviors.mjs'; enhanceAll();</script>
  <script>document.querySelectorAll('[data-choice-group]').forEach(group=>group.querySelectorAll('button').forEach(button=>button.addEventListener('click',()=>{group.querySelectorAll('button').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));})));</script>
</Layout>
