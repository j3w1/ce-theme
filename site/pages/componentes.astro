---
import Layout from '../layouts/Layout.astro';
import Recipe from '../components/Recipe.astro';
import Icon from '../components/Icon.astro';
const buttonCode=`<button class="ce-button">Ver productos</button>
<button class="ce-button ce-button--secondary">Conocer más</button>
<button class="ce-button ce-button--ink">Explorar</button>
<button class="ce-button" disabled>No disponible</button>`;
const fieldCode=`<div class="ce-field">
  <label for="search">Buscar un producto</label>
  <input class="ce-input" id="search" type="search"
    placeholder="¿Qué estás buscando?" aria-describedby="search-note">
  <span class="ce-field-note" id="search-note">Nombre o código de producto.</span>
</div>`;
const errorCode=`<div class="ce-field">
  <label for="email">Correo electrónico</label>
  <input class="ce-input" id="email" type="email" value="nombre@"
    aria-invalid="true" aria-describedby="email-error">
  <span class="ce-field-error" id="email-error">Escribe un correo completo.</span>
</div>`;
---
<Layout title="Componentes">
  <div class="container">
    <div class="page-intro"><p class="eyebrow">02 · Componentes</p><h1>Pequeñas piezas.<br/>Una misma intención.</h1><p>Recetas HTML y CSS que se adaptan a tu proyecto. Cada pieza usa la misma base de color, espacio y tipografía.</p></div>
    <Recipe title="Botones y acciones" description="Una acción principal por contexto. Las acciones secundarias mantienen una presencia más discreta." code={buttonCode}><div class="demo-row"><button class="ce-button">Ver productos</button><button class="ce-button ce-button--secondary">Conocer más</button><button class="ce-button ce-button--ink">Explorar</button><button class="ce-button" disabled>No disponible</button></div><p class="small-note">Muestras de estado y estilo. Los botones de esta sección no ejecutan operaciones de tienda.</p></Recipe>
    <Recipe title="Iconos y enlaces" description="Acciones compactas con un nombre accesible. Los iconos decorativos se ocultan a lectores de pantalla." code={'<button class="ce-icon-button" aria-label="Guardar producto">\n  <!-- Inline SVG: aria-hidden="true", focusable="false" -->\n</button>\n<a class="ce-link" href="/catalogo/">Explorar el catálogo</a>'}><div class="demo-row"><button class="ce-icon-button" aria-label="Ejemplo: guardar producto"><Icon name="heart"/></button><button class="ce-icon-button" aria-label="Ejemplo: bolsa de compra"><Icon name="bag"/></button><a class="ce-icon-button ce-icon-button--ink" href="/descargas/" aria-label="Ir a los recursos descargables"><Icon name="arrow"/></a><a class="ce-link" href="/patrones/">Explorar las recetas de producto</a></div></Recipe>
    <Recipe title="Búsqueda y formularios" description="Etiquetas visibles, instrucciones breves y errores que explican cómo continuar." code={fieldCode}><div class="demo-fields"><div class="ce-field"><label for="sample-search">Buscar un producto</label><input class="ce-input" id="sample-search" type="search" placeholder="¿Qué estás buscando?" aria-describedby="sample-search-note"/><span class="ce-field-note" id="sample-search-note">Nombre o código de producto. Campo de muestra.</span></div><div class="ce-field"><label for="sample-sort">Ordenar por</label><select class="ce-select" id="sample-sort"><option>Relevancia</option><option>Precio: menor a mayor</option><option>Novedades</option></select></div></div></Recipe>
    <Recipe title="Validación que ayuda" description="El borde y el mensaje trabajan juntos. El texto explica el problema sin depender solo del color." code={errorCode}><div class="demo-fields"><div class="ce-field"><label for="sample-email">Correo electrónico</label><input class="ce-input" type="email" id="sample-email" value="nombre@" aria-invalid="true" aria-describedby="sample-email-error"/><span class="ce-field-error" id="sample-email-error">Escribe un correo completo, por ejemplo: nombre@ejemplo.com.</span></div><div class="ce-field"><label for="sample-code">Código de producto</label><input class="ce-input" id="sample-code" value="CE26061509" readonly aria-describedby="sample-code-note"/><span class="ce-field-note" id="sample-code-note">Los códigos conservan sus caracteres originales.</span></div></div></Recipe>
    <Recipe title="Categorías y filtros" description="Controles agrupados con un estado de selección visible. Esta muestra permite cambiar la categoría activa." code={'<div role="group" aria-label="Categorías">\n  <button class="ce-chip" aria-pressed="true">Todos</button>\n  <button class="ce-chip" aria-pressed="false">Cocina</button>\n</div>'}><div class="demo-row" data-choice-group role="group" aria-label="Ejemplo de selección de categoría">{['Todos','Cocina','Organización','Iluminación','Decoración'].map((name,i)=><button class="ce-chip" aria-pressed={String(i===0)}>{name}</button>)}</div></Recipe>
    <Recipe title="Etiquetas y estados" description="Información breve, con un nombre explícito además del color." code={'<span class="ce-badge ce-badge--offer">Llegó la Navidad</span>\n<span class="ce-badge ce-badge--yellow">Precio especial</span>\n<span class="ce-status ce-status--success">✓ Disponible</span>'}><div class="demo-row"><span class="ce-badge ce-badge--offer">Llegó la Navidad</span><span class="ce-badge ce-badge--yellow">Precio especial</span><span class="ce-badge">Nuevo</span><span class="ce-status ce-status--success">✓ Disponible</span><span class="ce-status ce-status--info">i Información</span></div></Recipe>
    <Recipe title="Muestras de color" description="Cada muestra tiene un nombre, un borde visible y un estado de selección. Los colores representan el producto, no nuevas variantes de marca." code={'<button class="ce-swatch" aria-label="Color: blanco"\n  aria-pressed="true" style="background:var(--ce-color-surface-canvas)"></button>'}><div class="ce-swatches" data-choice-group role="group" aria-label="Ejemplo de selección de color"><button class="ce-swatch" aria-label="Blanco" aria-pressed="true" style="background:var(--ce-color-surface-canvas)"></button><button class="ce-swatch" aria-label="Negro" aria-pressed="false" style="background:var(--ce-color-surface-inverse)"></button><button class="ce-swatch" aria-label="Gris" aria-pressed="false" style="background:var(--ce-color-text-muted)"></button></div></Recipe>
    <Recipe title="Tablas para herramientas de trabajo" description="Una aplicación neutra de la misma base. Códigos legibles, columnas claras y sin colores que compitan con los datos." code={'<table class="ce-table">\n  <caption>Productos de ejemplo</caption>\n  <thead><tr><th scope="col">Código</th><th scope="col">Producto</th></tr></thead>\n  <tbody><tr><td>CE26061509</td><td>Dispensador aceite</td></tr></tbody>\n</table>'}><div class="table-wrap"><table class="ce-table"><caption class="ce-sr-only">Productos de ejemplo para una herramienta interna</caption><thead><tr><th scope="col">Código</th><th scope="col">Producto</th><th scope="col">Detalle</th></tr></thead><tbody><tr><td><span class="ce-code">CE26061509</span></td><td>Dispensador aceite</td><td>Vidrio, 350ml</td></tr><tr><td><span class="ce-code">CE26018821</span></td><td>Portabocadito Corazón</td><td>Cerámica, dos niveles</td></tr></tbody></table></div></Recipe>
  </div>
  <script>document.querySelectorAll('[data-choice-group]').forEach(group=>group.querySelectorAll('button').forEach(button=>button.addEventListener('click',()=>{group.querySelectorAll('button').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));})));</script>
</Layout>
