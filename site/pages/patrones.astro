---
import Layout from '../layouts/Layout.astro';
import Price from '../components/Price.astro';
import ProductCard from '../components/ProductCard.astro';
import Recipe from '../components/Recipe.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products.mjs';
import { productView, codeSegments } from '../../recipes/product.mjs';
import Pin from '../components/Pin.astro';
import { CEProductCode } from '@casaelida/vue';
// Marker letters are plain capitals without periods; the list repeats every marked product in text.
const tagged = [
  { letter: 'A', id: 'etiqueta-mene', x: '22.6%', y: '31.4%', product: products[0] },
  { letter: 'B', id: 'etiqueta-nome', x: '50%', y: '31%', product: products[1] },
  { letter: 'C', id: 'etiqueta-tilen', x: '85.8%', y: '45.6%', product: products[2] },
].map((item) => ({ ...item, view: productView(item.product) }));
const segments = (code: string) => codeSegments(code).map((part) => part.part === 'number' ? `<span class="ce-code-number">${part.text}</span>` : part.text).join('');
const codeHtml = `<span class="ce-code">${segments('CE26061509')}</span>`;
const taggedCode = `<figure class="ce-tagged-media">
  <img src="ambiente.jpg" alt="Tazas de vidrio y tapete de ducha en uso">
  <a class="ce-hotspot" href="#taza-mene" style="--ce-x:22%;--ce-y:34%">
    <span aria-hidden="true">A</span><span class="ce-sr-only">Producto A: MENE Taza de Vidrio Resistente al Calor</span>
  </a>
  <span class="ce-feature-tag" style="--ce-x:30%;--ce-y:62%;--ce-tag-width:8em">
    <span class="ce-feature-tag-label">de <strong>vidrio borosilicato</strong></span>
  </span>
</figure>
<ol class="ce-tag-list">
  <li class="ce-tag-item" id="taza-mene">
    <img src="taza-mene.png" alt="" width="160" height="160">
    <div class="ce-tag-item-info">
      <span class="ce-code">CE26061441</span>
      <h3 class="ce-tag-item-title"><span class="ce-hotspot ce-hotspot--inline" aria-hidden="true">A</span>
        <span class="ce-product-heading"><span class="ce-product-name">MENE</span><span class="ce-product-description">Taza de Vidrio Resistente al Calor</span></span></h3>
      <p class="ce-product-specs">vidrio borosilicato, 250ml</p>
      <!-- Insert the shared price recipe here. -->
    </div>
  </li>
</ol>`;
const pinCode = `<figure class="ce-tagged-media">
  <img src="ambiente.jpg" alt="Tazas de vidrio y tapete de ducha en uso">
  <div class="ce-pin" style="--ce-x:22%;--ce-y:34%">
    <button class="ce-pin-dot" type="button" aria-expanded="false" aria-controls="pin-mene-card">
      <span class="ce-sr-only">Ver MENE, Taza de Vidrio Resistente al Calor</span></button>
    <a class="ce-pin-card" id="pin-mene-card" href="/catalogo/mene">
      <div class="ce-pin-text">
        <span class="ce-product-name">MENE</span>
        <span class="ce-product-description">Taza de Vidrio Resistente al Calor</span>
        <!-- Insert the shared price recipe here. -->
      </div>
      <span class="ce-pin-chevron" aria-hidden="true"><!-- chevron icon --></span>
    </a>
  </div>
</figure>
<!-- enhancePins() from behaviors.mjs adds tap-to-open and keeps the card inside the photo. -->`;
const priceCode = `<span class="ce-price"><span class="ce-sr-only">Precio actual: 8.5 soles</span>
  <span class="ce-price-currency" aria-hidden="true">S/</span>
  <span class="ce-price-value" aria-hidden="true">8.5</span>
</span>
<!-- S/ at the size of the figures: add ce-price--joined. S/ raised: add ce-price--raised -->`;
const offerCode = `<div class="ce-price-block">
  <div class="ce-price-history">
    <span>Antes <del>S/15.5</del></span>
    <span class="ce-discount">−19.35%</span>
  </div>
  <span class="ce-price ce-price--offer"><span class="ce-sr-only">Precio actual: 12.5 soles</span>
    <span class="ce-price-currency" aria-hidden="true">S/</span>
    <span class="ce-price-value" aria-hidden="true">12.5</span>
  </span>
</div>
<!-- Alternatives: ce-price--sale (red block) or a campaign surface. -->`;
const cardCode = `<article class="ce-product">
  <div class="ce-product-media">
    <img src="taza.png" alt="MENE Taza de Vidrio Resistente al Calor" width="400" height="400">
  </div>
  <div class="ce-product-info">
    <span class="ce-code">CE26061441</span>
    <h3 class="ce-product-heading">
      <span class="ce-product-name">MENE</span>
      <span class="ce-product-description">Taza de Vidrio Resistente al Calor</span>
    </h3>
    <p class="ce-product-specs">vidrio borosilicato, 250ml</p>
    <!-- Insert the shared price recipe here. -->
  </div>
</article>`;
---
<Layout title="Precios y productos">
  <div class="container">
    <div class="page-intro"><p class="eyebrow">03 · Precios y productos</p><h1>Que se vea.<br/>Que se entienda.</h1><p>El NAME identifica, la descripción explica, el código acompaña y el precio destaca. Una jerarquía compartida en la tienda, las campañas, las etiquetas y los sistemas internos.</p></div>
    <nav class="page-nav" aria-label="En esta página"><a class="ce-link" href="#identidad">Identidad</a><a class="ce-link" href="#codigos">Códigos</a><a class="ce-link" href="#precios">Precios</a><a class="ce-link" href="#ofertas">Ofertas</a><a class="ce-link" href="#productos">Tarjetas</a><a class="ce-link" href="#etiquetas">Marcas sobre fotos</a><a class="ce-link" href="/tienda/">Tienda de ejemplo</a></nav>
    <div class="price-contract"><p><strong>Decisiones aprobadas.</strong> NAME en mayúsculas; descripción en tipo título, 1px más grande; especificaciones en minúsculas. <strong>S/</strong> sobre la línea base y decimales completos: <strong>S/8.5</strong>, <strong>S/20</strong>, <strong>S/14.5</strong>. El bloque amarillo es la promoción por defecto.</p></div>

    <div id="identidad"><Recipe title="NAME, descripción y especificaciones" description="Tres niveles con una sola escala: --ce-product-text. productView da formato a los datos suministrados; nunca inventa campos que faltan." code={'<h3 class="ce-product-heading">\n  <span class="ce-product-name">WILUL</span>\n  <span class="ce-product-description">Frasco Mielero</span>\n</h3>\n<p class="ce-product-specs">vidrio/bambú, 450ml</p>'}>
      <div class="demo-fields">{[['16px', '1rem'], ['24px', '1.5rem']].map(([label, size]) => <div style={`--ce-product-text:${size}`}><p class="demo-label">Texto base {label}</p><p class="ce-product-heading"><span class="ce-product-name">WILUL</span><span class="ce-product-description">Frasco Mielero</span></p><p class="ce-product-specs">vidrio/bambú, 450ml</p></div>)}</div>
    </Recipe></div>

    <div id="codigos"><Recipe title="Un código con su propio lugar" description="Blanco y negrita sobre negro, con relleno proporcional y esquinas apenas redondeadas. En pantalla se subrayan los cuatro dígitos del número; al imprimir, no. Copiar devuelve el código exacto." code={codeHtml}><div class="code-specimens"><CEProductCode code="CE26061509" /><CEProductCode code="CE26031111R12R" /><CEProductCode code="7730744292227" /><CEProductCode code="CE26061477" style="font-size:24px" /></div><p class="small-note">Un código no se convierte a número, no se corta y no se sustituye por un nombre comercial. El estilo de insignia es solo para códigos Casa Elida.</p></Recipe></div>

    <div id="precios"><Recipe title="El precio de todos los días" description="Negro sobre blanco. La cifra tiene el mayor peso visual; S/ es más pequeño y se apoya en la línea base. La segunda opción es S/ unido, del mismo tamaño que la cifra; el S/ elevado sigue disponible. La base del precio (cada uno, /pack de 12) se inclina hacia arriba." code={priceCode}><div class="demo-prices"><div><p class="demo-label">Entero</p><Price amount="20.00"/></div><div><p class="demo-label">Un decimal</p><Price amount="8.50"/></div><div><p class="demo-label">S/ unido (segunda opción)</p><Price amount="8.50" currencyStyle="joined"/></div><div><p class="demo-label">S/ elevado (variante)</p><Price amount="8.50" currencyStyle="raised"/></div><div><p class="demo-label">Unidad: cada uno</p><Price amount="5.50" unitLabel="cada uno"/></div><div><p class="demo-label">Presentación: pack</p><Price amount="1.99" presentationLabel="pack de 50"/></div><div><p class="demo-label">Precio Promo con presentación</p><Price amount="10" previousAmount="12.50" discountLabel="20%" presentationLabel="pack de 25"/></div><div><p class="demo-label">Precio Rebajas con presentación</p><Price amount="6" previousAmount="8" discountLabel="25%" variant="sale" presentationLabel="pack de 6"/></div></div></Recipe></div>

    <div id="ofertas"><Recipe title="Una oferta que destaca" description="Bloque amarillo por defecto. El importe anterior lleva “Antes” y tachado. El porcentaje es un dato comercial suministrado, no un cálculo del componente." code={offerCode}><div class="demo-prices"><div><p class="demo-label">Amarillo (por defecto)</p><Price amount="12.50" previousAmount="15.50" discountLabel="19.35%"/></div><div><p class="demo-label">Rojo de rebajas</p><Price amount="11" previousAmount="16" discountLabel="31.25%" variant="sale"/></div><div><p class="demo-label">Precio por unidad</p><Price amount="5.50" unitLabel="cada uno"/></div></div></Recipe></div>

    <div id="productos"><Recipe title="La tarjeta de catálogo" description="Foto completa, código, NAME, descripción, especificaciones y precio. Las filas de precio se alinean aunque los textos ocupen varias líneas." code={cardCode}><div class="ce-product-grid">{products.map((product) => <ProductCard product={product}/>)}</div><p class="small-note">Importes de ejemplo. Fotos del catálogo público de Casa Elida. Más variantes (favoritos, disponibilidad, más opciones) en la <a class="ce-link" href="/tienda/categoria/">tienda de ejemplo</a>.</p></Recipe></div>

    <Recipe title="La tarjeta que acompaña al producto" description="Una tarjeta blanca con foto, identificación y precio para piezas editoriales donde el producto ya se ve en contexto." code={'<article class="ce-callout">\n  <img src="taza.png" alt="NOME Taza de Vidrio">\n  <div>\n    <h3 class="ce-product-heading"><span class="ce-product-name">NOME</span><span class="ce-product-description">Taza de Vidrio</span></h3>\n    <p class="ce-product-specs">vidrio borosilicato, 350ml</p>\n    <!-- Insert the shared price recipe here. -->\n  </div>\n</article>'}><div class="callout-stage"><article class="ce-callout"><img src="/assets/product-nome.png" alt="NOME Taza de Vidrio" width="300" height="300" loading="lazy"/><div><h3 class="ce-product-heading"><span class="ce-product-name">NOME</span><span class="ce-product-description">Taza de Vidrio</span></h3><p class="ce-product-specs">vidrio borosilicato, 350ml</p><Price amount="8" unitLabel="cada una"/></div></article></div></Recipe>

    <div id="puntos"><Recipe title="Puntos con ficha en la web" description="Un punto sobre la foto muestra la ficha del producto al pasar el cursor, al enfocar con el teclado o al tocar: NAME, descripción, precio de la tienda elegida y una flecha que lleva a la ficha completa. Es el estilo de la tienda en línea; las letras A, B, C quedan para medios sin cursor." code={pinCode}>
      <figure class="tagged-scene"><div class="ce-tagged-media">
        <div class="tagged-scene-art" role="img" aria-label="Composición de ejemplo con dos tazas de vidrio y un tapete de ducha"><img src="/assets/product-mene.png" alt="" width="300" height="300" loading="lazy"/><img src="/assets/product-nome.png" alt="" width="300" height="300" loading="lazy"/><img src="/assets/product-tilen.png" alt="" width="300" height="300" loading="lazy"/></div>
        {tagged.map((item, index) => <Pin item={item.product} x={item.x} y={item.y} id={`patron-pin-${item.letter.toLowerCase()}`} open={index === 0} />)}</div>
        <figcaption class="small-note">Pasa el cursor sobre un punto, o tócalo. Composición de ejemplo con fotos del catálogo. Precios de ejemplo.</figcaption>
      </figure>
    </Recipe></div>

    <div id="etiquetas"><Recipe title="Marcas con letra para publicaciones y medios sin cursor" description="Círculos negros con letras blancas A, B, C, sin punto, para redes sociales, impresos e imágenes compartidas, donde no hay cursor. Cada letra lleva a su producto en la lista, que repite toda la información en texto." code={taggedCode}>
      <figure class="tagged-scene"><div class="ce-tagged-media" data-ce-tags="auto">
        <div class="tagged-scene-art" role="img" aria-label="Composición de ejemplo con dos tazas de vidrio y un tapete de ducha"><img src="/assets/product-mene.png" alt="" width="300" height="300" loading="lazy"/><img src="/assets/product-nome.png" alt="" width="300" height="300" loading="lazy"/><img src="/assets/product-tilen.png" alt="" width="300" height="300" loading="lazy"/></div>
        {tagged.map((item) => <a class="ce-hotspot" href={`#${item.id}`} style={`--ce-x:${item.x};--ce-y:${item.y}`}><span aria-hidden="true">{item.letter}</span><span class="ce-sr-only">{`Producto ${item.letter}: ${item.view.accessibleName}`}</span></a>)}
        <span class="ce-feature-tag ce-feature-tag--light ce-feature-tag--above" style="--ce-x:9.8%;--ce-y:43%;--ce-line:36px;--ce-tag-width:9em"><span class="ce-feature-tag-label">de <strong>vidrio borosilicato</strong></span></span>
        <span class="ce-feature-tag ce-feature-tag--above" style="--ce-x:75%;--ce-y:50%;--ce-line:100px;--ce-tag-width:12em"><span class="ce-feature-tag-label">base <strong>antideslizante</strong></span></span></div>
        <figcaption class="small-note">Composición de ejemplo con fotos del catálogo. Precios de ejemplo.</figcaption>
      </figure>
      <ol class="ce-tag-list">{tagged.map((item) => <li class="ce-tag-item" id={item.id}><img src={item.view.image} alt="" width="160" height="160" loading="lazy"/><div class="ce-tag-item-info"><span class="ce-code">{item.view.code}</span><h3 class="ce-tag-item-title"><span class="ce-hotspot ce-hotspot--inline" aria-hidden="true">{item.letter}</span><span class="ce-product-heading"><span class="ce-product-name">{item.view.name}</span><span class="ce-product-description">{item.view.description}</span></span></h3><p class="ce-product-specs">{item.view.specs.join(', ')}</p><Price amount={item.product.amount} previousAmount={item.product.previousAmount} discountLabel={item.product.discountLabel}/></div></li>)}</ol>
    </Recipe></div>

    <section class="section"><h2>Una composición, tres niveles de información.</h2><div class="rule-grid"><div><h3>01 · Identificar</h3><p>NAME en mayúsculas y el código negro, legibles sin competir con la foto.</p></div><div><h3>02 · Explicar</h3><p>Descripción y especificaciones breves: material, capacidad o medidas. Solo lo que el producto trae.</p></div><div><h3>03 · Mostrar el valor</h3><p>El precio es el elemento tipográfico más grande. En ofertas, el precio anterior queda cerca del actual.</p></div><div><h3>Siempre en texto real</h3><p>En web, códigos, nombres y precios son texto seleccionable y accesible. Las vistas previas al compartir no muestran precios.</p></div></div></section>
  </div>
</Layout>
