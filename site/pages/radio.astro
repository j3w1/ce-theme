---
import Layout from '../layouts/Layout.astro';
import RadioFrame from '../components/RadioFrame.astro';
const swatches = [
  ['bg', 'Fondo'], ['surface', 'Superficie'], ['raised', 'Elevada'], ['line', 'Línea'], ['control', 'Borde de control'],
  ['text', 'Texto'], ['muted', 'Texto secundario'], ['faint', 'Texto pequeño'], ['signal', 'Señal: música'], ['alert', 'Señal: SPOT y alertas'], ['ok', 'Confirmación'],
];
---
<Layout title="CE Radio" description="El tema oscuro de CE Radio: la estación de Casa Elida para música y anuncios en tienda.">
  <div class="container">
    <div class="page-intro"><p class="eyebrow">Aplicaciones · CE Radio</p><h1>La estación de Casa Elida.</h1><p>Carbón y blanco cálido. El amarillo y el rojo de la marca aparecen como señales: un punto, un anillo, una línea. Nunca llenan la pantalla.</p></div>
    <section class="section" aria-labelledby="estados" style="padding-top:0">
      <h2 id="estados">Una ventana, varios estados</h2>
      <p class="section-description" style="margin-bottom:var(--ce-space-32)">Ventanas de 480 × 360 y 480 × 320. Cada estado tiene su señal de color y, además, una línea de estado en texto.</p>
      <div class="radio-gallery">
        <RadioFrame label="En vivo: avance en amarillo, próximo SPOT en la línea inferior." />
        <RadioFrame state="spot-on" status="SPOT · promo-octubre.mp3" spot={{ name: 'promo-octubre.mp3', hint: 'al aire', phase: 'playing', progress: 55 }} label="SPOT al aire: anillo y línea en rojo; la música da un paso atrás." />
        <RadioFrame offline label="Sin conexión: una señal roja y un solo Reintentar." />
        <RadioFrame season="navidad" playlist="Latinas" label="Navidad: pino nevado, solo mientras suena una lista navideña." />
        <RadioFrame view="sheet" label="Listas: dos grupos; Navidad con su propia superficie." />
        <RadioFrame height={320} state="spot-next" status="SPOT al terminar la canción" spot={{ name: 'Siguiente SPOT', hint: 'al terminar', phase: 'due', progress: 92 }} badge="ok" label="Ventana baja (320): el escenario cede altura primero; aviso de archivo añadido." />
      </div>
    </section>
    <section class="section" aria-labelledby="paleta">
      <h2 id="paleta">Paleta de la estación</h2>
      <div class="radio-swatches" data-ce-theme="radio">{swatches.map(([token, label]) => <div class="radio-swatch"><span style={`background:var(--ce-color-radio-${token})`}></span><strong>{label}</strong><code>color.radio.{token}</code></div>)}</div>
      <p class="small-note">Contrastes verificados en <code>ce-theme.json</code>. Guía técnica en inglés: <a class="ce-link" href="/downloads/radio.md">radio.md</a>.</p>
    </section>
    <section class="section" aria-labelledby="recetas">
      <h2 id="recetas">Las recetas compartidas, en oscuro</h2>
      <p class="section-description" style="margin-bottom:var(--ce-space-24)">Dentro de <code>data-ce-theme="radio"</code>, botones, campos y avisos de Casa Elida toman la paleta de la estación.</p>
      <div class="radio-recipes" data-ce-theme="radio">
        <div class="demo-row"><button class="ce-button" type="button">Probar SPOT</button><button class="ce-button ce-button--secondary" type="button">Cancelar SPOT</button><button class="ce-chip" type="button" aria-pressed="true">Siempre activa</button></div>
        <div class="ce-field" style="max-width:320px"><label for="radio-carpeta">Carpeta de SPOTS</label><input class="ce-input" id="radio-carpeta" value="Escritorio\SPOTS" /><span class="ce-field-note">MP3, WAV o FLAC.</span></div>
        <div class="ce-notice ce-notice--warning"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 8v5m0 3v.01M3.5 19 12 4l8.5 15h-17Z" /></svg><div><strong>Un archivo no es válido</strong><p>Se omitirá hasta que lo reemplaces.</p></div></div>
      </div>
    </section>
  </div>
</Layout>
