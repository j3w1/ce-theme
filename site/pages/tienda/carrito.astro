---
import Store from '../../layouts/Store.astro';
import Icon from '../../components/Icon.astro';
import Price from '../../components/Price.astro';
import ProductCard from '../../components/ProductCard.astro';
import StoreBar from '../../components/StoreBar.astro';
import { productView } from '../../../recipes/product.mjs';
import { catalogue, stores } from '../../data/store.mjs';
import { url } from '../../url.mjs';
// Line and order amounts are supplied per store by the commerce service as decimal strings; the page never computes them.
// Each store's amounts are a separate view, so no amount is shown for a store it was not supplied for, and none without a store.
const lines = [
  { item: catalogue[0], quantity: 2, lineAmount: { tacna: '13.00', arequipa: '13.80' } },
  { item: catalogue[3], quantity: 1, lineAmount: { tacna: '8.50', arequipa: '8.50' } },
];
const summary = {
  tacna: { subtotal: 'S/21.50', pickup: 'Sin costo', total: 'S/21.50' },
  arequipa: { subtotal: 'S/22.30', pickup: 'Sin costo', total: 'S/22.30' },
};
---
<Store title="Tu carrito" description="Carrito y pago de demostración con retiro en tienda o envío.">
  <div class="ce-container">
    <h1 class="store-page-title">Tu carrito</h1>
    <ol class="ce-steps" aria-label="Pasos de compra" style="margin-bottom:var(--ce-space-32)">
      <li aria-current="step"><span class="ce-step-label">Carrito</span></li>
      <li><span class="ce-step-label">Entrega</span></li>
      <li><span class="ce-step-label">Pago</span></li>
    </ol>
    <div class="ce-cart">
      <div>
        <StoreBar lead="Importes en" />
        <ul class="ce-cart-lines" aria-label="Productos en tu carrito">
          {lines.map(({ item, quantity, lineAmount }, index) => { const view = productView(item); return (
            <li class="ce-cart-line">
              <img src={view.image} alt="" width="128" height="128" />
              <div class="ce-cart-line-body">
                <h2 class="ce-product-heading" style="--ce-product-text:1rem"><a class="ce-product-link" href={url('/tienda/producto/')}><span class="ce-product-name">{view.name}</span><span class="ce-product-description">{view.description}</span></a></h2>
                <p class="ce-product-specs">{view.specs.join(', ')}</p>
                <span class="ce-code" style="justify-self:start">{view.code}</span>
                <div class="ce-cart-line-actions">
                  <div class="ce-quantity"><button type="button" aria-label={`Quitar uno de ${view.name}`}><Icon name="minus" size={18} /></button><label class="ce-sr-only" for={`cantidad-${index}`}>{`Cantidad de ${view.name}`}</label><input id={`cantidad-${index}`} type="number" inputmode="numeric" min="1" max="20" value={quantity} /><button type="button" aria-label={`Agregar uno de ${view.name}`}><Icon name="plus" size={18} /></button></div>
                  {stores.map((store) => <div data-store-view={store.id} hidden={store.id !== 'tacna'}><Price amount={lineAmount[store.id]} /></div>)}
                  <span data-store-view="ninguna" hidden class="ce-store-note">Elige tu tienda para ver el precio.</span>
                  <button class="ce-link" type="button"><Icon name="trash" size={18} /> Quitar</button>
                </div>
              </div>
            </li>
          ); })}
        </ul>

        <section aria-labelledby="entrega" style="margin-top:var(--ce-space-40)">
          <h2 id="entrega" style="font-size:var(--ce-font-size-title)">¿Cómo quieres recibirlo?</h2>
          <fieldset class="ce-choice-cards"><legend class="ce-sr-only">Forma de entrega</legend>
            <label class="ce-choice-card"><input type="radio" name="entrega" value="retiro" checked /><span class="ce-choice-card-title">Retiro en tienda</span><span>En <span data-store-name>Tacna</span>. Te avisamos cuando esté listo.</span></label>
            <label class="ce-choice-card"><input type="radio" name="entrega" value="envio" /><span class="ce-choice-card-title">Envío a domicilio</span><span>Costo y plazo según tu dirección.</span></label>
            <label class="ce-choice-card"><input type="radio" name="entrega" value="otra" disabled /><span class="ce-choice-card-title">Retiro por otra persona</span><span>No disponible en esta demostración.</span></label>
          </fieldset>
        </section>
      </div>
      <aside class="ce-order-summary" aria-labelledby="resumen">
        <h2 id="resumen">Resumen</h2>
        {stores.map((store) => <dl class="ce-summary" data-store-view={store.id} hidden={store.id !== 'tacna'}>
          <div><dt>Subtotal (3 productos)</dt><dd>{summary[store.id].subtotal}</dd></div>
          <div><dt>Retiro en tienda</dt><dd>{summary[store.id].pickup}</dd></div>
          <div class="ce-summary-total"><dt>Total</dt><dd>{summary[store.id].total}</dd></div>
        </dl>)}
        <div data-store-view="ninguna" hidden class="ce-price-pending"><span>Elige tu tienda para ver precio y disponibilidad.</span></div>
        <a class="ce-button" href={url('/tienda/cuenta/')}>Continuar</a>
        <p class="ce-fine-print">Importes de ejemplo calculados por el servicio de comercio, no por la interfaz.</p>
      </aside>
    </div>

    <section class="ce-section" id="favoritos" aria-labelledby="favoritos-titulo">
      <div class="ce-section-head"><h2 id="favoritos-titulo">Tus favoritos</h2></div>
      <div class="ce-product-grid">{catalogue.slice(1, 3).map((item) => <ProductCard product={item} href={url('/tienda/producto/')} showCode={false} priceNote="Precio y disponibilidad al elegir tu tienda." />)}</div>
    </section>
  </div>
</Store>
